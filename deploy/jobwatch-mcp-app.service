[Unit]
Description=Jobwatch embedded MCP App
After=jobwatch-agent.service
Requires=jobwatch-agent.service
[Service]
Type=simple
WorkingDirectory=%h/apps/jobwatch-native
EnvironmentFile=%h/.config/jobwatch-native/agent.env
ExecStart=%h/apps/jobwatch-native/.venv/bin/jobwatch-mcp-app --host 127.0.0.1 --port 18918
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
[Install]
WantedBy=default.target
