# Copy to ~/.config/jobwatch/settings.env (or .env) and fill in. Never commit it.
JOBWATCH_DATA_DIR=~/.local/share/jobwatch  # where profiles, DBs, drafts live (one folder per person inside)
JOBWATCH_PUBLIC_HOST=jobs.example.com      # the address you open the board at (omit for localhost only)
JOBWATCH_BOARD_URL=https://jobs.example.com

# Sign-in
JOBWATCH_SESSION_SECRET=                   # long random string; leave empty to turn sign-in off (single person)
JOBWATCH_INVITE_CODE=                      # people sign up with this code; empty = sign-up closed
JOBWATCH_OWNER_PASSWORD=                   # password of the first person

# Models: any OpenAI-compatible gateway (your own key)
JOBWATCH_LLM_BASE_URL=https://api.openai.com/v1
JOBWATCH_LLM_API_KEY=
JOBWATCH_LLM_MODEL=gpt-4o                   # default model id for every role

# Optional: push urgent messages to a personal assistant over ssh (leave empty for none)
JOBWATCH_HERMES_SSH=
JOBWATCH_HERMES_FILE=

# Connect Google (your own OAuth client, see SETUP.md). These may also live in google.env
# next to settings.env, which Jobwatch reads as well.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://jobs.example.com/connect/google/callback
